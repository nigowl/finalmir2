<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefineConstants>$(DefineConstants);PORTABLE_CLIENT</DefineConstants>
    <NoWarn>$(NoWarn);CS8600;CS8602;CS8604;CS8625</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Shared/Shared.csproj" />
    <Compile Include="../Client/MirObjects/MapCode.cs" Link="Original/MapCode.cs" />
    <Compile Include="../Client/MirObjects/Frames.cs" Link="Original/Frames.cs" />
  </ItemGroup>
</Project>
