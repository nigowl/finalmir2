@inject Microsoft.Extensions.Hosting.IHostEnvironment HostEnvironment
@inject Microsoft.AspNetCore.Mvc.ViewFeatures.IFileVersionProvider FileVersions
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <base href="/" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <link href="@FileVersions.AddFileVersionToPath("", "/app.css")" rel="stylesheet" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>
<body>
    <Routes @rendermode="InteractiveServer" />
    <div id="blazor-error-ui">连接中断，请刷新页面重新连接。<a href="">重新连接</a></div>
    @if (HostEnvironment.IsDevelopment() && Environment.GetEnvironmentVariable("DOTNET_WATCH") == "1")
    {
        <script src="_framework/blazor.web.js" autostart="false"></script>
        <script src="admin-watch.js"></script>
    }
    else
    {
        <script src="_framework/blazor.web.js"></script>
    }
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
</body>
</html>
