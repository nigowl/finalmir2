@inject IDialogService Dialogs
<AdminDialog>
    <DialogContent>
        <MudStack Row="true" Class="mb-3" AlignItems="AlignItems.Center">
            <MudTextField T="string" Immediate="true" Margin="Margin.Dense" Variant="Variant.Outlined" Label="搜索名称 / 编号" @bind-Value="search" OnKeyDown="SearchKey" />
            <MudButton Disabled="loading" OnClick="Search" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default">搜索 / 刷新</MudButton>
            <MudText Typo="Typo.body2">共 @total 条 · 每页 50 条</MudText>
        </MudStack>
        @if (error != null) { <MudAlert Severity="Severity.Error">@error</MudAlert> }
        @if (loading) { <MudProgressLinear Indeterminate="true" Class="mb-3" /> }
        <div class="@(Kind == "monsters" ? "monster-catalog-gallery" : "npc-catalog-gallery")" aria-label="@(Kind == "monsters" ? "全部怪物瀑布流" : "全部 NPC 瀑布流")">
            @foreach (var entry in items)
            {
                @if (Kind == "monsters")
                {
                    <article class="monster-catalog-card" @key="entry.Id">
                        <button type="button" class="monster-catalog-entry" aria-label="@($"#{entry.Id} {entry.Name}")" @onclick="@(() => ShowMonster(entry))">
                            <span class="monster-catalog-portrait">
                                <img class="catalog-sprite" src="@Image(entry)" alt="@($"怪物形象：{entry.Name}")" loading="lazy" />
                            </span>
                            <span class="monster-catalog-details">
                                <span class="monster-catalog-name">#@entry.Id @entry.Name</span>
                                <span class="monster-catalog-stats">
                                @foreach (var key in CardStats)
                                {
                                    <span class="monster-stat" data-stat="@key"><span>@(key == "经验奖励" ? "经验" : key)</span><span>@entry.Attributes.GetValueOrDefault(key, "—")</span></span>
                                }
                                </span>
                            </span>
                        </button>
                        @if (SelectMode) { <MudButton Size="Size.Small" Color="Color.Primary" OnClick="@(() => Pick(entry))" Variant="Variant.Text">选择</MudButton> }
                    </article>
                }
                else
                {
                    <article class="npc-catalog-card" @key="entry.Id">
                        <div class="npc-catalog-card-heading">
                            <MudText Typo="Typo.subtitle2">#@entry.Id @entry.Name</MudText>
                            <MudButton Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined" OnClick="@(() => ViewNpc(entry))" aria-label="@($"查看 NPC：{entry.Name}")">查看</MudButton>
                        </div>
                        <img class="catalog-sprite" src="@Image(entry)" alt="@($"NPC 形象：{entry.Name}")" loading="lazy" />
                        @foreach (var property in entry.Attributes) { <MudText Typo="Typo.caption" Class="path">@property.Key：@property.Value</MudText> }
                    </article>
                }
            }
        </div>
        @if (items.Length == 0 && !loading) { <MudText>没有符合条件的条目。</MudText> }
    </DialogContent>
    <DialogActions><div class="catalog-pagination"><MudPagination Count="PageCount" Selected="page" SelectedChanged="ChangePage" Disabled="loading" Size="Size.Small" ShowFirstButton="true" ShowLastButton="true" /></div></DialogActions>
</AdminDialog>
@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = null!;
    [Parameter] public string Kind { get; set; } = "monsters";
    [Parameter] public bool SelectMode { get; set; }
    private static readonly string[] CardStats = ["等级", "生命", "攻击", "防御", "魔御", "经验奖励"];
    private CatalogFigure[] items = [];
    private int page = 1, total, generation;
    private string search = "";
    private string? error;
    private bool loading;
    private int PageCount => Math.Max(1, (total + 49) / 50);
    private static string Image(CatalogFigure entry) => $"/asset-preview?library={Uri.EscapeDataString(entry.Library)}&index={entry.Frame}";
    private void Pick(CatalogFigure entry) { if (SelectMode && Kind == "monsters") Dialog.Close(DialogResult.Ok(entry)); }
    private void ViewNpc(CatalogFigure entry) { if (Kind == "npcs") Dialog.Close(DialogResult.Ok(entry)); }
    private async Task ShowMonster(CatalogFigure entry)
    {
        var dialog = await Dialogs.ShowAsync<MonsterEditor>($"怪物：{entry.Name}", new DialogParameters<MonsterEditor> { { d => d.Id, entry.Id } }, AdminDialog.StandardOptions);
        if ((await dialog.Result)?.Canceled == false) await Load();
    }
    protected override Task OnInitializedAsync() => Load();
    private Task Search() { page = 1; return Load(); }
    private Task ChangePage(int value) { page = value; return Load(); }
    private Task SearchKey(KeyboardEventArgs args) => args.Key == "Enter" ? Search() : Task.CompletedTask;
    private async Task Load()
    {
        var request = ++generation; loading = true; error = null;
        try
        {
            var result = await Api.Get<CatalogFigurePage>($"management/admin/catalog/{Kind}?page={page}&search={Uri.EscapeDataString(search)}");
            if (request != generation) return;
            items = result.Items; total = result.Total;
        }
        catch (Exception e) { if (request == generation) error = e.Message; }
        finally { if (request == generation) loading = false; }
    }
}
