@inherits LayoutComponentBase
@inject Mir2.Hosting.ProjectPaths Paths
<MudThemeProvider Theme="AdminTheme.Dark" IsDarkMode="true" />
<MudPopoverProvider /><MudDialogProvider /><MudSnackbarProvider />
<MudLayout>
    <MudAppBar Elevation="0" Dense="true">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" OnClick="@(() => drawer = !drawer)" aria-label="打开导航" Size="Size.Small" />
        <MudText Typo="Typo.h6">FinalMir2 · 管理控制台</MudText><MudSpacer />
        <MudText Typo="Typo.caption" Class="mr-3">程序 v@(Mir2.Hosting.ProgramVersion.Current)</MudText>
        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">版本：@Paths.VersionName</MudChip>
        <form action="/auth/logout" method="post"><AntiforgeryToken /><button class="logout" type="submit">退出</button></form>
    </MudAppBar>
    <MudDrawer @bind-Open="drawer" Elevation="1" Variant="DrawerVariant.Responsive">
        <a class="admin-brand" href="/" aria-label="FinalMir2 管理首页">
            <MudIcon Icon="@Icons.Material.Filled.SportsEsports" />
            <span><strong>FinalMir2</strong><small>游戏管理控制台</small></span>
        </a>
        <MudNavMenu>
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.MonitorHeart">运行监控</MudNavLink>
            <MudNavLink Href="/accounts" Icon="@Icons.Material.Filled.ManageAccounts">游戏账户</MudNavLink>
            <MudNavLink Href="/characters" Icon="@Icons.Material.Filled.Person">角色管理</MudNavLink>
            <MudNavLink Href="/guilds" Icon="@Icons.Material.Filled.Groups">行会管理</MudNavLink>
            <MudNavLink Href="/companions" Icon="@Icons.Material.Filled.SmartToy">陪玩管理</MudNavLink>
            <MudNavLink Href="/shop" Icon="@Icons.Material.Filled.Storefront">商城管理</MudNavLink>
            <MudNavLink Href="/population" Icon="@Icons.Material.Filled.Pets">刷怪管理</MudNavLink>
            <MudNavLink Href="/npcs" Icon="@Icons.Material.Filled.PersonPinCircle">NPC管理</MudNavLink>
            <MudNavLink Href="/resources" Icon="@Icons.Material.Filled.Folder">资源管理</MudNavLink>
            <MudNavLink Href="/settings" Icon="@Icons.Material.Filled.Settings">系统设置</MudNavLink>
            <MudNavLink Href="/development" Icon="@Icons.Material.Filled.Code">游戏开发</MudNavLink>

        </MudNavMenu>
        <MudText Class="pa-4" Typo="Typo.caption">配置与数据按版本隔离</MudText>
    </MudDrawer>
    <MudMainContent Class="admin-compact"><MudContainer MaxWidth="MaxWidth.False" Class="admin-page">@Body</MudContainer></MudMainContent>
</MudLayout>
@code {
    private bool drawer = true;
}
