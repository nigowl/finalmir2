@using System.Text.Json
<AdminDialog Visible="true" Title="@(Preset.Version.Length==0?"新增日程预设":"编辑日程预设")" OnClose="OnClose" OnSave="Save" Busy="busy" Dirty="@(original!=Draft)" SaveConfirmation="保存此日程预设？已有角色复制的日程参数保持不变。">
<DialogContent>
    @if(error!=null){<MudAlert Severity="Severity.Error">@error</MudAlert>}
    <MudTextField T="string" Label="日程名称" Value="name" ValueChanged="@(v=>name=v)" Immediate="true" MaxLength="40" Margin="Margin.Dense" Variant="Variant.Outlined" />
    <ScheduleFields @bind-Schedule="schedule" ShowPresets="false" />
</DialogContent>
</AdminDialog>
@code{
    [Parameter,EditorRequired]public CompanionSchedulePreset Preset{get;set;}=null!;
    [Parameter]public EventCallback OnClose{get;set;}
    [Parameter]public EventCallback OnSaved{get;set;}
    private string name="",original="";private CompanionSchedule schedule=new();private bool busy;private string? error;
    private string Draft=>JsonSerializer.Serialize(new{name,schedule});
    protected override void OnInitialized(){name=Preset.Name;schedule=CompanionSchedulePresets.Copy(Preset.Schedule);original=Draft;}
    private async Task Save()
    {
        busy=true;error=null;
        try{var value=Preset with{Name=name.Trim(),Schedule=schedule};if(Preset.Version.Length==0)await Api.Post<ActionResult>("management/companions/schedules",value);else await Api.Put<ActionResult>($"management/companions/schedules/{Preset.Id}",value);await OnSaved.InvokeAsync();}
        catch(Exception e){error=e.Message;}finally{busy=false;}
    }
}
