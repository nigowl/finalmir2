<MudTable T="CompanionEvent" Items="Events.Reverse()" Dense="true" Hover="true" FixedHeader="true" Height="300px" aria-label="最近运行事件">
    <HeaderContent><MudTh>时间（@Zone）</MudTh><MudTh>事件</MudTh><MudTh>状态</MudTh><MudTh>说明</MudTh></HeaderContent>
    <RowTemplate>
        <MudTd Class="event-time">@TimeZoneInfo.ConvertTime(context.Time,CompanionScheduling.Zone(Zone)).ToString("MM-dd HH:mm:ss")</MudTd>
        <MudTd>@Kind(context.Kind)</MudTd><MudTd>@(context.State.Length>0?context.State:"—")</MudTd>
        <MudTd Class="event-description">@Description(context)</MudTd>
    </RowTemplate>
    <NoRecordsContent><MudText>暂无运行事件。</MudText></NoRecordsContent>
</MudTable>
@code {
    [Parameter] public CompanionEvent[] Events { get; set; } = [];
    [Parameter] public string Zone { get; set; } = "Asia/Shanghai";
    private static string Kind(string value) => value switch
    {
        "status"=>"状态变化", "registered"=>"账户绑定", "entered"=>"进入游戏", "configured"=>"配置更新", "failed"=>"运行异常",
        "stopped"=>"下线", "social"=>"聊天", "guild"=>"行会活动", "asset"=>"物品操作", "healing"=>"自疗回执", "escape"=>"回城保护", "death"=>"死亡", "llm"=>"模型对话", "llm-goal"=>"模型建议", "llm-log"=>"LLM日志", "diagnostic"=>"运行提示", "goal-blocked"=>"目标调整", _=>"运行事件"
    };
    private static string Description(CompanionEvent e) => e.Kind switch
    {
        "registered"=>"已绑定游戏账户", "entered"=>"角色已进入游戏", "configured"=>"已应用最新配置",
        "llm"=>"请求生成聊天回复", "llm-goal"=>"请求评估当前可选目标",
        "goal-blocked"=>e.Reason,
        "asset"=>Asset(e.Text), _=>string.Join(" · ",new[]{e.Reason,e.Text}.Where(s=>s.Length>0))
    };
    private static string Asset(string value)
    {
        var parts=value.Split(':',2);
        var action=parts[0] switch {"buy"=>"购买", "sell"=>"出售", "repair"=>"修理", "equip"=>"装备", "remove" or "unequip"=>"卸下", "learn"=>"学习", "use"=>"使用",
            "storage-store"=>"存仓", "storage-take"=>"取回", "storage-split"=>"仓库拆分", "storage-password"=>"设置托管仓库密码", "storage-unlock"=>"解锁仓库", "guild-create"=>"建会", "guild-join"=>"入会", _=>parts[0]};
        return parts.Length>1?$"{action}：{parts[1]}":action;
    }
}
