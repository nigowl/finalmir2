@if (Settings != null)
{
    <MudGrid Spacing="2" Class="my-2">
        @if (Group == "combat")
        {
            <MudItem xs="12" sm="6"><MudNumericField T="float" Label="玩家物理伤害倍率" Min="0.01f" Max="100f" Step=".1f" @bind-Value="Settings.PlayerPhysicalDamageRate" @bind-Value:after="Notify" Margin="Margin.Dense" Variant="Variant.Outlined" Immediate="true" HelperText="影响物理攻击伤害" /></MudItem>
            <MudItem xs="12" sm="6"><MudNumericField T="float" Label="玩家法术伤害倍率" Min="0.01f" Max="100f" Step=".1f" @bind-Value="Settings.PlayerMagicDamageRate" @bind-Value:after="Notify" Margin="Margin.Dense" Variant="Variant.Outlined" Immediate="true" HelperText="影响法术伤害，包含火墙" /></MudItem>
            <MudItem xs="12" sm="6"><MudNumericField T="float" Label="玩家对战额外伤害倍率" Min="0.01f" Max="100f" Step=".1f" @bind-Value="Settings.PlayerPvpDamageRate" @bind-Value:after="Notify" Margin="Margin.Dense" Variant="Variant.Outlined" Immediate="true" HelperText="玩家/英雄间伤害再乘此值；不改变安全区权限" /></MudItem>
            <MudItem xs="12" sm="6"><MudNumericField T="float" Label="怪物伤害倍率" Min="0.01f" Max="100f" Step=".1f" @bind-Value="Settings.MonsterDamageRate" @bind-Value:after="Notify" Margin="Margin.Dense" Variant="Variant.Outlined" Immediate="true" HelperText="野怪和敌对召唤物造成的伤害" /></MudItem>
            <MudItem xs="12" sm="6"><MudNumericField T="float" Label="战宠伤害倍率" Min="0.01f" Max="100f" Step=".1f" @bind-Value="Settings.PetDamageRate" @bind-Value:after="Notify" Margin="Margin.Dense" Variant="Variant.Outlined" Immediate="true" HelperText="玩家/英雄所属战宠；遵守归属和攻击权限" /></MudItem>
            <MudItem xs="12" sm="6"><MudNumericField T="float" Label="技能冷却时间倍率" Min="0.1f" Max="10f" Step=".1f" @bind-Value="Settings.SkillCooldownRate" @bind-Value:after="Notify" Margin="Margin.Dense" Variant="Variant.Outlined" Immediate="true" HelperText="越小冷却越短；保存后重启同步技能数据" /></MudItem>
            <MudItem xs="12" sm="6"><MudNumericField T="int" Label="玩家基础攻速修正" Min="-20" Max="30" @bind-Value="Settings.PlayerAttackSpeedBonus" @bind-Value:after="Notify" Margin="Margin.Dense" Variant="Variant.Outlined" Immediate="true" HelperText="每点约减少60毫秒，最低550毫秒；影响玩家和英雄" /></MudItem>
            <MudItem xs="12" sm="6"><MudNumericField T="int" Label="暴击率系数" Min="1" Max="255" @bind-Value="Settings.CriticalRateWeight" @bind-Value:after="Notify" Margin="Margin.Dense" Variant="Variant.Outlined" Immediate="true" HelperText="暴击属性乘此系数，最高100%" /></MudItem>
            <MudItem xs="12" sm="6"><MudNumericField T="int" Label="暴击伤害除数" Min="1" Max="255" @bind-Value="Settings.CriticalDamageWeight" @bind-Value:after="Notify" Margin="Margin.Dense" Variant="Variant.Outlined" Immediate="true" HelperText="越小暴击伤害越高" /></MudItem>
            <MudItem xs="12" sm="6"><MudNumericField T="int" Label="幸运判定基数" Min="1" Max="255" @bind-Value="Settings.MaxLuck" @bind-Value:after="Notify" Margin="Margin.Dense" Variant="Variant.Outlined" Immediate="true" HelperText="影响触发最高攻击的概率" /></MudItem>
            <MudItem xs="12" sm="6"><MudCheckBox T="bool" Dense="true" Label="玩家对战允许抗魔" @bind-Value="Settings.PvpCanResistMagic" @bind-Value:after="Notify" /></MudItem>
        }
        @if (Group == "effects")
        {
            <MudItem xs="12" sm="6"><MudNumericField T="float" Label="中毒持续伤害倍率" Min="0.01f" Max="100f" Step=".1f" @bind-Value="Settings.PoisonDamageRate" @bind-Value:after="Notify" Margin="Margin.Dense" Variant="Variant.Outlined" Immediate="true" HelperText="绿毒/流血的每次伤害；不改变红毒降防比例" /></MudItem>
            <MudItem xs="12" sm="6"><MudNumericField T="float" Label="中毒持续时间倍率" Min="0.1f" Max="10f" Step=".1f" @bind-Value="Settings.PoisonDurationRate" @bind-Value:after="Notify" Margin="Margin.Dense" Variant="Variant.Outlined" Immediate="true" HelperText="红毒/绿毒/流血；仅影响后续新施加状态" /></MudItem>
            <MudItem xs="12" sm="6"><MudNumericField T="float" Label="控制状态时间倍率" Min="0.1f" Max="10f" Step=".1f" @bind-Value="Settings.ControlDurationRate" @bind-Value:after="Notify" Margin="Margin.Dense" Variant="Variant.Outlined" Immediate="true" HelperText="麻痹、冰冻、减速、眩晕、失明；不改固定延时爆炸" /></MudItem>
            <MudItem xs="12" sm="6"><MudNumericField T="float" Label="技能加成时间倍率" Min="0.1f" Max="10f" Step=".1f" @bind-Value="Settings.SkillBuffDurationRate" @bind-Value:after="Notify" Margin="Margin.Dense" Variant="Variant.Outlined" Immediate="true" HelperText="技能Buff，永久/物品Buff及盾受击剩余时间不重复放大" /></MudItem>
            <MudItem xs="12" sm="6"><MudNumericField T="int" Label="魔法抗性判定基数" Min="1" Max="255" @bind-Value="Settings.MagicResistWeight" @bind-Value:after="Notify" Margin="Margin.Dense" Variant="Variant.Outlined" Immediate="true" HelperText="越大越难抵抗" /></MudItem>
            <MudItem xs="12" sm="6"><MudNumericField T="int" Label="毒抗判定基数" Min="1" Max="255" @bind-Value="Settings.PoisonResistWeight" @bind-Value:after="Notify" Margin="Margin.Dense" Variant="Variant.Outlined" Immediate="true" HelperText="影响抵抗中毒的概率" /></MudItem>
            <MudItem xs="12" sm="6"><MudNumericField T="int" Label="冰冻判定基数" Min="1" Max="255" @bind-Value="Settings.FreezingAttackWeight" @bind-Value:after="Notify" Margin="Margin.Dense" Variant="Variant.Outlined" Immediate="true" HelperText="影响装备冰冻的触发概率" /></MudItem>
            <MudItem xs="12" sm="6"><MudNumericField T="int" Label="毒素判定基数" Min="1" Max="255" @bind-Value="Settings.PoisonAttackWeight" @bind-Value:after="Notify" Margin="Margin.Dense" Variant="Variant.Outlined" Immediate="true" HelperText="影响装备毒素的触发概率" /></MudItem>
            <MudItem xs="12" sm="6"><MudNumericField T="int" Label="生命恢复属性除数" Min="1" Max="255" @bind-Value="Settings.HealthRegenWeight" @bind-Value:after="Notify" Margin="Margin.Dense" Variant="Variant.Outlined" Immediate="true" HelperText="越小生命恢复加成越高" /></MudItem>
            <MudItem xs="12" sm="6"><MudNumericField T="int" Label="魔力恢复属性除数" Min="1" Max="255" @bind-Value="Settings.ManaRegenWeight" @bind-Value:after="Notify" Margin="Margin.Dense" Variant="Variant.Outlined" Immediate="true" HelperText="越小魔力恢复加成越高" /></MudItem>
            <MudItem xs="12" sm="6"><MudCheckBox T="bool" Dense="true" Label="玩家对战允许抗毒" @bind-Value="Settings.PvpCanResistPoison" @bind-Value:after="Notify" /></MudItem>
            <MudItem xs="12" sm="6"><MudCheckBox T="bool" Dense="true" Label="玩家对战允许冰冻" @bind-Value="Settings.PvpCanFreeze" @bind-Value:after="Notify" /></MudItem>
        }
        @if (Group == "monster")
        {
            <MudItem xs="12" sm="6"><MudNumericField T="float" Label="怪物生命倍率" Min="0.01f" Max="100f" Step=".1f" @bind-Value="Settings.MonsterHpRate" @bind-Value:after="Notify" Margin="Margin.Dense" Variant="Variant.Outlined" Immediate="true" HelperText="新刷出或属性刷新时生效，不重置现存生命" /></MudItem>
            <MudItem xs="12" sm="6"><MudNumericField T="float" Label="怪物防御倍率" Min="0.01f" Max="100f" Step=".1f" @bind-Value="Settings.MonsterDefenceRate" @bind-Value:after="Notify" Margin="Margin.Dense" Variant="Variant.Outlined" Immediate="true" HelperText="物防/魔防；新刷出或属性刷新时生效" /></MudItem>
            <MudItem xs="12" sm="6"><MudNumericField T="float" Label="怪物攻击速度倍率" Min="0.1f" Max="5f" Step=".1f" @bind-Value="Settings.MonsterAttackSpeedRate" @bind-Value:after="Notify" Margin="Margin.Dense" Variant="Variant.Outlined" Immediate="true" HelperText="越大越快；新刷出或属性刷新时生效，含战宠基础速度" /></MudItem>
            <MudItem xs="12" sm="6"><MudNumericField T="float" Label="怪物移动速度倍率" Min="0.1f" Max="5f" Step=".1f" @bind-Value="Settings.MonsterMoveSpeedRate" @bind-Value:after="Notify" Margin="Margin.Dense" Variant="Variant.Outlined" Immediate="true" HelperText="越大越快；新刷出/恢复速度时生效，含战宠基础速度" /></MudItem>
            <MudItem xs="12" sm="6"><MudNumericField T="int" Label="可驯服首领上限" Min="0" Max="10" @bind-Value="Settings.MaxBossTames" @bind-Value:after="Notify" Margin="Margin.Dense" Variant="Variant.Outlined" Immediate="true" HelperText="仅对可驯服且满足技能条件的首领生效" /></MudItem>
            <MudItem xs="12" sm="6"><MudCheckBox T="bool" Dense="true" Label="保存战宠" @bind-Value="Settings.PetSave" @bind-Value:after="Notify" /></MudItem>
        }
        @if (Group == "game")
        {
            <MudItem xs="12" sm="6"><MudCheckBox T="bool" Dense="true" Label="允许怪物掉金币" @bind-Value="Settings.DropGold" @bind-Value:after="Notify" /></MudItem>
            <MudItem xs="12" sm="6"><MudNumericField T="uint" Label="单次金币掉落上限" Min="1u" Max="100000000u" @bind-Value="Settings.MaxDropGold" @bind-Value:after="Notify" Margin="Margin.Dense" Variant="Variant.Outlined" Immediate="true" HelperText="超过上限时分成多堆" /></MudItem>
            <MudItem xs="12" sm="6"><MudNumericField T="int" Label="掉落搜索范围" Min="1" Max="20" @bind-Value="Settings.DropRange" @bind-Value:after="Notify" Margin="Margin.Dense" Variant="Variant.Outlined" Immediate="true" HelperText="寻找掉落位置的格数" /></MudItem>
            <MudItem xs="12" sm="6"><MudNumericField T="int" Label="同格掉落堆数" Min="1" Max="100" @bind-Value="Settings.DropStackSize" @bind-Value:after="Notify" Margin="Margin.Dense" Variant="Variant.Outlined" Immediate="true" HelperText="每格最多容纳的掉落堆数" /></MudItem>
        }
    </MudGrid>
}
@code {
    [Parameter, EditorRequired] public ServerSettings Settings { get; set; } = null!;
    [Parameter] public string Group { get; set; } = "combat";
    [Parameter] public EventCallback Changed { get; set; }
    private Task Notify() => Changed.InvokeAsync();
}

