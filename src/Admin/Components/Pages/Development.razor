@page "/development"
@attribute [Authorize]
@inject IDialogService Dialogs
<PageTitle>游戏开发 · Mir2</PageTitle>
<MudText Typo="Typo.h4" HtmlTag="h1" GutterBottom="true">游戏开发工具</MudText>
<MudText Color="Color.Secondary" Class="mb-5">配置、NPC / 任务 / 掉落脚本和游戏定义使用服务端同一份数据，保存时保留备份。</MudText>
@if (error != null) { <MudAlert Severity="Severity.Error" Class="mb-4">@error</MudAlert> }
@if (notice != null) { <MudAlert Severity="Severity.Success" Class="mb-4">@notice</MudAlert> }
<MudTabs @bind-ActivePanelIndex="activeTab" KeepPanelsAlive="true" Elevation="0" Rounded="true">
    <MudTabPanel Text="脚本与配置">
        <MudStack Row="true" Wrap="Wrap.Wrap" Class="mb-3"><MudTextField Margin="Margin.Dense" Variant="Variant.Outlined" Immediate="true" T="string" Label="搜索文件路径" @bind-Value="search" /><MudButton OnClick="LoadFiles" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default">搜索文件</MudButton><MudButton OnClick="New" Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small">新增文件</MudButton><MudButton Disabled="busy" OnClick="ReloadScripts" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default">重载 NPC / 掉落</MudButton><MudButton Disabled="busy" Color="Color.Warning" OnClick="Restart" Size="Size.Small" Variant="Variant.Outlined">保存并重启游戏</MudButton></MudStack>
        <MudTable T="string" Items="files" Dense="true" RowsPerPage="10"><HeaderContent><MudTh>文件路径</MudTh><MudTh>操作</MudTh></HeaderContent><RowTemplate><MudTd Class="path">@context</MudTd><MudTd><MudButton Disabled="busy" Size="Size.Small" OnClick="@(() => Open(context))" Variant="Variant.Text" Color="Color.Primary">编辑</MudButton></MudTd></RowTemplate><PagerContent><MudTablePager RowsPerPageString="每页条数" InfoFormat="{first_item}–{last_item}，共 {all_items} 条" AllItemsText="全部" /></PagerContent></MudTable>
        <AdminDialog @bind-Visible="editorOpen" Title="@(document == null ? "新增脚本 / 配置" : document.Path)" OnClose="Close" OnSave="Save" CanSave="@(document != null && document.Path == path && (Dirty || document.Version.Length == 0))" Busy="busy" Dirty="@(Dirty || (document == null && path.Length > 0))">
            <DialogContent>
                @if (error != null) { <MudAlert Severity="Severity.Error">@error</MudAlert> }
                <MudStack Row="true" Class="mb-3"><MudTextField Margin="Margin.Dense" Variant="Variant.Outlined" Immediate="true" T="string" Label="文件路径（Configs/ 或 Envir/）" @bind-Value="path" Disabled="@(busy || document != null)" /><MudButton Disabled="@(busy || document != null)" OnClick="@(() => Open(path))" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default">读取 / 新建</MudButton></MudStack>
                <MudTextField Margin="Margin.Dense" Immediate="true" T="string" @bind-Value="content" Lines="14" Variant="Variant.Outlined" Class="code" Label="文件内容" Disabled="@(busy || document == null)" />
                <MudAlert Severity="Severity.Info" Class="mt-3">保存采用版本检查并保留备份。NPC / 掉落脚本保存后可重载；任务和配置修改需要重启游戏引擎。</MudAlert>
            </DialogContent>
        </AdminDialog>
    </MudTabPanel>
    <MudTabPanel Text="游戏数据库"><Mir2.Admin.Components.Development.WorldCatalog OpenScript="OpenScript" /></MudTabPanel>
</MudTabs>
@code {
    private string[] files = []; private TextDocument? document;
    private string search = "", path = "", content = "";
    private bool busy, editorOpen; private int activeTab; private string? error, notice;
    private bool Dirty => document != null && content != document.Content;
    protected override Task OnInitializedAsync() => LoadFiles();
    private async Task LoadFiles() { try { files = await Api.Get<string[]>("management/development/files?search=" + Uri.EscapeDataString(search)); error = null; } catch (Exception e) { error = e.Message; } }
    private async Task Open(string file)
    {
        busy = true;
        try { document = await Api.Get<TextDocument>("management/development/file?path=" + Uri.EscapeDataString(file)); path = document.Path; content = document.Content; error = null; editorOpen = true; }
        catch (Exception e) { error = e.Message; } finally { busy = false; }
    }
    private void New() { document = null; path = content = ""; error = null; editorOpen = true; }
    private void Close() { editorOpen = false; document = null; content = ""; }
    private async Task OpenScript(string file) { activeTab = 0; await Open(file); }
    private async Task Save()
    {
        if (document == null) return; busy = true;
        try { document = await Api.Put<TextDocument>("management/development/file", new TextEdit(document.Path, content, document.Version)); editorOpen = false; notice = "文件已备份并保存。重载脚本或重启游戏使修改生效。"; await LoadFiles(); }
        catch (Exception e) { error = e.Message; } finally { busy = false; }
    }
    private async Task ReloadScripts() { if (!await AdminDialog.Confirm(Dialogs, "确认重载脚本", "确认使已保存的 NPC / 掉落脚本立即生效？", "确认执行")) return; try { notice = (await Api.Post<ActionResult>("management/reload-scripts")).Message; } catch (Exception e) { error = e.Message; } }
    private async Task Restart() { if (!await AdminDialog.Confirm(Dialogs, "确认重启游戏", "将保存并重启游戏引擎，在线玩家需要重新连接。", "确认执行")) return; busy = true; try { notice = (await Api.Post<ActionResult>("management/restart")).Message; } catch (Exception e) { error = e.Message; } finally { busy = false; } }
}
