@page "/shop"
@attribute [Authorize]
@using System.Text.Json
@inject IDialogService Dialogs
<PageTitle>商城 · Mir2</PageTitle>
<MudText Typo="Typo.h4" HtmlTag="h1">商城</MudText>
<MudText Color="Color.Secondary" Class="my-3">设置当前版本商城的选项卡和商品。保存后即时生效，玩家重新打开或刷新商城即可读取。</MudText>
@if(error!=null){<MudAlert Severity="Severity.Error" Dense="true" Class="my-2">@error</MudAlert>}
@if(notice!=null){<MudAlert Severity="Severity.Success" Dense="true" Class="my-2">@notice</MudAlert>}
@if(document!=null)
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="my-3">
        <MudText>@document.Catalog.Tabs.Length 个选项卡 · @document.Catalog.Tabs.Sum(tab=>tab.Products.Length) 种商品</MudText><MudSpacer />
        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" Disabled="busy" OnClick="Edit">编辑</MudButton>
        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default" Disabled="busy" OnClick="Load">刷新</MudButton>
    </MudStack>
    <MudTabs>
        @foreach(var tab in document.Catalog.Tabs)
        {
            <MudTabPanel Text="@tab.Name">
                <MudTable T="PublicShopProduct" Items="tab.Products" Dense="true" RowsPerPage="10">
                    <HeaderContent><MudTh>商品</MudTh><MudTh>编号</MudTh><MudTh>单价（金币）</MudTh></HeaderContent>
                    <RowTemplate><MudTd>@Name(context.ItemIndex)</MudTd><MudTd>@context.ItemIndex</MudTd><MudTd>@Price(context.Price)</MudTd></RowTemplate>
                    <NoRecordsContent><MudText>当前选项卡暂无商品。</MudText></NoRecordsContent>
                    <PagerContent><MudTablePager RowsPerPageString="每页条数" /></PagerContent>
                </MudTable>
            </MudTabPanel>
        }
    </MudTabs>
}
@if(draft!=null&&document!=null)
{
    <AdminDialog Visible="true" Title="编辑商城" OnClose="@(()=>draft=null)" OnSave="Save" Busy="busy" Dirty="@(original!=JsonSerializer.Serialize(draft))" SaveConfirmation="保存当前版本商城？将保留数据库备份；商品与价格立即生效，旧报价会重新校验。">
        <DialogContent>
            @if(error!=null){<MudAlert Severity="Severity.Error" Dense="true" Class="my-2">@error</MudAlert>}
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
                <MudText>选项卡 @draft.Tabs.Length / 8</MudText><MudSpacer />
                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(busy||draft.Tabs.Length>=8)" OnClick="AddTab">新增选项卡</MudButton>
            </MudStack>
            @* 页签重排后重建组件注册顺序，草稿仍保留在同一目录中。 *@
            <MudTabs @key="TabOrder" @bind-ActivePanelIndex="editingTab">
                @foreach(var tab in draft.Tabs)
                {
                    <MudTabPanel Text="@tab.Name" @key="tab.Id">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Class="my-3">
                            <MudTextField T="string" Label="选项卡名称" @bind-Value="tab.Name" MaxLength="16" Margin="Margin.Dense" Variant="Variant.Outlined" Immediate="true" Disabled="busy" />
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default" Disabled="@(busy||Array.IndexOf(draft.Tabs,tab)==0)" OnClick="@(()=>MoveTab(tab,-1))">左移</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default" Disabled="@(busy||Array.IndexOf(draft.Tabs,tab)==draft.Tabs.Length-1)" OnClick="@(()=>MoveTab(tab,1))">右移</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" Disabled="@(busy||draft.Tabs.Length<=1)" OnClick="@(()=>DeleteTab(tab))">删除选项卡</MudButton>
                        </MudStack>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Class="my-3">
                            <MudAutocomplete T="CatalogRow" Label="查找商品名称或编号" SearchFunc="Search" ToStringFunc="@(item=>item==null?"":$"{item.Name} (#{item.Id})")" @bind-Value="selectedItem" Clearable="true" ResetValueOnEmptyText="true" Margin="Margin.Dense" Variant="Variant.Outlined" Disabled="busy" />
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(busy||selectedItem==null)" OnClick="@(()=>AddProduct(tab))">添加</MudButton>
                        </MudStack>
                        <MudText Typo="Typo.caption">单价填0沿用默认价格规则及系统倍率；毒符按整包结算。同一商品只能放入一个选项卡。</MudText>
                        <MudTable T="PublicShopProduct" Items="tab.Products" Dense="true" RowsPerPage="10" Class="mt-2">
                            <HeaderContent><MudTh>商品</MudTh><MudTh>单价（金币）</MudTh><MudTh>操作</MudTh></HeaderContent>
                            <RowTemplate>
                                <MudTd>@Name(context.ItemIndex) (#@context.ItemIndex)</MudTd>
                                <MudTd><MudNumericField T="uint" @bind-Value="context.Price" Min="0" Margin="Margin.Dense" Variant="Variant.Outlined" Immediate="true" Disabled="busy" /></MudTd>
                                <MudTd><MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" Disabled="busy" OnClick="@(()=>RemoveProduct(tab,context))">移除</MudButton></MudTd>
                            </RowTemplate>
                            <NoRecordsContent><MudText>查找并添加此分类的商品。</MudText></NoRecordsContent>
                            <PagerContent><MudTablePager RowsPerPageString="每页条数" /></PagerContent>
                        </MudTable>
                    </MudTabPanel>
                }
            </MudTabs>
        </DialogContent>
    </AdminDialog>
}
@code {
    private PublicShopDocument? document; private PublicShopCatalog? draft; private CatalogRow[] items=[];
    private string TabOrder=>string.Join(",",draft?.Tabs.Select(tab=>tab.Id)??[]);
    private CatalogRow? selectedItem; private string original=""; private string? error,notice; private bool busy; private int editingTab;
    protected override Task OnInitializedAsync()=>Load();
    private async Task Load()
    {
        busy=true;
        try{document=await Api.Get<PublicShopDocument>("management/shop");items=await Api.Get<CatalogRow[]>("management/shop/items");error=null;}
        catch(Exception e){error=e.Message;}finally{busy=false;}
    }
    private string Name(int id)=>items.FirstOrDefault(item=>item.Id==id)?.Name??$"未知商品 #{id}";
    private static string Price(uint value)=>value==0?"默认价格":value.ToString("N0");
    private Task<IEnumerable<CatalogRow>> Search(string query,CancellationToken token)=>Task.FromResult(items.Where(item=>string.IsNullOrWhiteSpace(query)||item.Name.Contains(query,StringComparison.OrdinalIgnoreCase)||item.Id.ToString().Contains(query)).Take(50));
    private void Edit(){draft=JsonSerializer.Deserialize<PublicShopCatalog>(JsonSerializer.Serialize(document!.Catalog));original=JsonSerializer.Serialize(draft);editingTab=0;selectedItem=null;error=null;}
    private void AddTab()
    {
        if(draft==null||busy||draft.Tabs.Length>=8)return;
        var id=Enumerable.Range(0,32).First(id=>draft.Tabs.All(tab=>tab.Id!=id));
        var name=Enumerable.Range(1,32).Select(i=>$"分类{i}").First(name=>draft.Tabs.All(tab=>tab.Name!=name));
        draft.Tabs=[..draft.Tabs,new PublicShopTab{Id=(byte)id,Name=name}];editingTab=draft.Tabs.Length-1;
    }
    private void MoveTab(PublicShopTab tab,int delta)
    {
        if(draft==null||busy)return;var from=Array.IndexOf(draft.Tabs,tab);var to=from+delta;
        if(from<0||to<0||to>=draft.Tabs.Length)return;
        (draft.Tabs[from],draft.Tabs[to])=(draft.Tabs[to],draft.Tabs[from]);editingTab=to;
    }
    private async Task DeleteTab(PublicShopTab tab)
    {
        if(draft==null||busy||draft.Tabs.Length<=1)return;
        if(!await AdminDialog.Confirm(Dialogs,"删除选项卡",$"删除「{tab.Name}」及其中{tab.Products.Length}条商城配置？已有玩家物品不受影响，保存后生效。","删除"))return;
        draft.Tabs=draft.Tabs.Where(item=>item!=tab).ToArray();editingTab=Math.Min(editingTab,draft.Tabs.Length-1);
    }
    private void AddProduct(PublicShopTab tab)
    {
        if(draft==null||selectedItem==null||busy)return;
        if(draft.Tabs.Any(t=>t.Products.Any(product=>product.ItemIndex==selectedItem.Id))){error="该商品已在商城中，请先从原选项卡移除。";return;}
        if(draft.Tabs.Sum(t=>t.Products.Length)>=512){error="商城最多512种商品。";return;}
        tab.Products=[..tab.Products,new PublicShopProduct{ItemIndex=selectedItem.Id}];selectedItem=null;error=null;
    }
    private async Task RemoveProduct(PublicShopTab tab,PublicShopProduct product)
    {
        if(busy||!await AdminDialog.Confirm(Dialogs,"移除商品",$"从「{tab.Name}」移除「{Name(product.ItemIndex)}」？保存后生效。","移除"))return;
        tab.Products=tab.Products.Where(item=>item!=product).ToArray();
    }
    private async Task Save()
    {
        if(draft==null||document==null||busy)return;busy=true;
        try{document=await Api.Put<PublicShopDocument>("management/shop",new PublicShopEdit(draft,document.Version));draft=null;error=null;notice="商城已保存，刷新或重新打开游戏商城后生效。";}
        catch(Exception e){error=e.Message;}finally{busy=false;}
    }
}
