@page "/npcs"
@attribute [Authorize]
@using Mir2.Admin.Components.Administration
@inject IDialogService Dialogs
<PageTitle>NPC管理 · Mir2</PageTitle>
<MudText Typo="Typo.h4" HtmlTag="h1">NPC管理</MudText>
<MudText Class="my-3" Color="Color.Secondary">小地图快速定位，大地图点击 NPC管理；点击可行走位置新增 NPC。属性与 TXT 脚本在弹窗中编辑。</MudText>
@if (error != null) { <MudAlert Severity="Severity.Error" Class="my-3">@error</MudAlert> }
@if (notice != null) { <MudAlert Severity="Severity.Success" Class="my-3">@notice</MudAlert> }
<MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mb-4">
    <MapPicker Maps="maps" Value="mapId" ValueChanged="SelectMap" Disabled="@(busy || editorOpen)" Npcs="true" />
    <MudButton OnClick="Load" Disabled="busy" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default">刷新地图</MudButton>
    <MudButton OnClick="ShowNpcs" Disabled="@(busy || editorOpen)" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default">NPC列表</MudButton>
</MudStack>
@if (busy) { <MudProgressLinear Indeterminate="true" /> }
@if (map != null)
{
    <MudPaper Class="pa-3 mb-4" Elevation="1">
        <NativeNpcMap @key="(map.Id, map.ImageVersion, locationRevision)" Map="map" FocusNpcId="focusNpcId" PointChosen="Create" MarkerChosen="EditMarker" />
    </MudPaper>
    <MudTextField Margin="Margin.Dense" Variant="Variant.Outlined" T="string" Label="搜索当前地图 NPC" Immediate="true" @bind-Value="search" Class="mb-3" />
    <MudTable T="NpcDefinition" Items="map.Npcs.Where(n => n.Name.Contains(search, StringComparison.OrdinalIgnoreCase) || n.Id.ToString() == search)" Dense="true" Hover="true" RowsPerPage="10">
        <HeaderContent><MudTh>NPC</MudTh><MudTh>坐标</MudTh><MudTh>脚本</MudTh><MudTh>操作</MudTh></HeaderContent>
        <RowTemplate><MudTd>#@context.Id @context.Name</MudTd><MudTd>(@context.X, @context.Y)</MudTd><MudTd Class="path">@context.FileName</MudTd><MudTd><MudButton Disabled="@(busy || editorOpen)" OnClick="@(() => Open(context))" Size="Size.Small" Variant="Variant.Text" Color="Color.Primary">管理</MudButton></MudTd></RowTemplate>
        <NoRecordsContent><MudText>当前地图没有符合条件的 NPC，可点击地图新增。</MudText></NoRecordsContent>
        <PagerContent><MudTablePager RowsPerPageString="每页条数" InfoFormat="{first_item}–{last_item}，共 {all_items} 条" AllItemsText="全部" /></PagerContent>
    </MudTable>
}
@code {
    private MapChoice[] maps = []; private MapOverview? map;
    private int mapId, locationRevision; private int? focusNpcId; private bool busy, editorOpen; private string search = ""; private string? error, notice;
    protected override async Task OnInitializedAsync()
    {
        try { maps = await Api.Get<MapChoice[]>("management/admin/maps"); mapId = maps.FirstOrDefault()?.Id ?? 0; if (mapId != 0) await Load(); }
        catch (Exception e) { error = e.Message; }
    }
    private async Task SelectMap(int id) { mapId = id; map = null; focusNpcId = null; search = ""; await Load(); }
    private async Task Load()
    {
        busy = true; error = null;
        try { maps = await Api.Get<MapChoice[]>("management/admin/maps"); map = await Api.Get<MapOverview>($"management/admin/maps/{mapId}"); }
        catch (Exception e) { error = e.Message; }
        finally { busy = false; }
    }
    private Task Create(MapPoint point) => Open(null, point);
    private async Task ShowNpcs()
    {
        var dialog = await Dialogs.ShowAsync<WorldFigureDialog>("全部 NPC", new DialogParameters<WorldFigureDialog> { { dialog => dialog.Kind, "npcs" } }, AdminDialog.StandardOptions);
        if ((await dialog.Result) is not { Canceled: false, Data: CatalogFigure npc }) return;
        busy = true; error = null;
        try
        {
            var target = await Api.Get<NpcDefinition>($"management/development/npcs/{npc.Id}");
            await SelectMap(target.MapId); focusNpcId = target.Id; locationRevision++;
        }
        catch (Exception e) { error = e.Message; }
        finally { busy = false; }
    }
    private Task EditMarker(PopulationMarker marker) => Open(map!.Npcs.Single(n => n.Id == marker.Id));
    private async Task Open(NpcDefinition? npc, MapPoint? point = null)
    {
        if (busy || editorOpen || map == null) return;
        editorOpen = true;
        try
        {
            var parameters = new DialogParameters<NpcEditor> { { editor => editor.Map, map }, { editor => editor.Current, npc }, { editor => editor.Point, point } };
            var dialog = await Dialogs.ShowAsync<NpcEditor>(npc == null ? "新增 NPC" : $"NPC #{npc.Id} · {npc.Name}", parameters,
                AdminDialog.StandardOptions);
            var result = await dialog.Result;
            if (result?.Canceled == false) { notice = result.Data as string; await Load(); }
        }
        finally { editorOpen = false; }
    }
}
