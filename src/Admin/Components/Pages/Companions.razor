@page "/companions"
@attribute [Authorize]
@implements IAsyncDisposable
@inject IDialogService Dialogs
@using System.Text.Json
@using Mir2.Admin.Components.Companions
<PageTitle>陪玩管理 · Mir2</PageTitle>
<MudText Typo="Typo.h4" HtmlTag="h1">陪玩管理</MudText>
<MudText Color="Color.Secondary" Class="my-3">管理角色、人格与作息，数据随当前版本保存。</MudText>
@if(error!=null){<MudAlert Severity="Severity.Error" Class="my-2">@error</MudAlert>}
@if(notice!=null){<MudAlert Severity="Severity.Success" Class="my-2">@notice</MudAlert>}
@if(busy||loading){<MudProgressLinear Indeterminate="true" />}
@if(overview!=null)
{
<MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2" Class="my-3">
    <MudChip T="string" Color="@(overview.Settings.Enabled?Color.Success:Color.Default)">总开关：@(overview.Settings.Enabled?"开启":"关闭")</MudChip>
    <MudChip T="string">运行 @overview.Online / @overview.Settings.MaxOnline</MudChip>
    @if(overview.Dispatch is { } dispatch){<MudChip T="string">排队 @dispatch.Waiting · 休息 @dispatch.Resting · 下线中 @dispatch.Stopping</MudChip>}
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="New" Size="Size.Small">新增陪玩</MudButton>
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="@(()=>batch=true)" Size="Size.Small">批量新增陪玩</MudButton>
    <MudButton Variant="Variant.Outlined" OnClick="Settings" Size="Size.Small" Color="Color.Default">陪玩设置</MudButton>
    <MudButton Disabled="@(busy||loading)" OnClick="Load" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default">刷新</MudButton>
</MudStack>
@if(overview.Limits is { } limits)
{
    <MudAlert Severity="@(limits.EffectiveMaxOnline<overview.Settings.MaxOnline?Severity.Warning:Severity.Info)" Dense="true" Class="mb-3">
        陪玩上限 @overview.Settings.MaxOnline · 总连接上限 @limits.MaxConnections（真人预留 @overview.Settings.ReservePlayers）· 同 IP 连接上限 @limits.MaxPerIp（本机预留 1）· 当前理论上限 @limits.EffectiveMaxOnline
        <MudLink Href="/settings" Class="ml-2">系统设置</MudLink>
        <MudText Typo="Typo.caption">注册与建角频率由系统设置控制；实际在线人数还取决于角色日程与在线额度。</MudText>
    </MudAlert>
}
<MudTabs>
<MudTabPanel Text="陪玩角色">
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="my-3">
        <MudTextField T="string" Margin="Margin.Dense" Variant="Variant.Outlined" Label="昵称 / 别名 / 标签 / 人格" @bind-Value="search" />
        <MudSelect T="string" Label="状态" Value="status" ValueChanged="FilterStatus" Margin="Margin.Dense" Variant="Variant.Outlined" Dense="true">
            <MudSelectItem Value="@string.Empty">全部状态</MudSelectItem>
            <MudSelectItem Value="@("online")">在线</MudSelectItem><MudSelectItem Value="@("offline")">离线</MudSelectItem>
            <MudSelectItem Value="@("queued")">排队中</MudSelectItem><MudSelectItem Value="@("paused")">已暂停</MudSelectItem>
            <MudSelectItem Value="@("resting")">休息中</MudSelectItem><MudSelectItem Value="@("error")">需处理 / 托管恢复</MudSelectItem>
            <MudSelectItem Value="@("disabled")">已停用</MudSelectItem>
        </MudSelect>
        <MudButton Disabled="@(busy||loading)" OnClick="Search" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default">查询</MudButton>
    </MudStack>
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="my-2">
        <MudText>已选 @selected.Count 个角色（跨页保留）</MudText>
        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default" Disabled="@(busy||loading||selected.Count==0)" OnClick="@(()=>selected.Clear())">清除选择</MudButton>
        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" Disabled="@(busy||loading||selected.Count==0)" OnClick="@(()=>selectedSchedules=selected.Values.ToArray())">批量日程设置</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Success" Disabled="@(busy||loading||selected.Count==0)" OnClick="@(()=>SelectedCommand("start"))" Size="Size.Small">批量上线</MudButton>
        <MudButton Color="Color.Warning" Disabled="@(busy||loading||selected.Count==0)" OnClick="@(()=>SelectedCommand("stop"))" Size="Size.Small" Variant="Variant.Outlined">批量下线</MudButton>
        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" Disabled="@(busy||loading||selected.Count==0)" OnClick="@(()=>selectedLlm=selected.Values.ToArray())">批量LLM设置</MudButton>
    </MudStack>
    <MudTable T="CompanionRow" Items="rows" Dense="true" Hover="true">
    <HeaderContent><MudTh><MudCheckBox T="bool" Dense="true" aria-label="选择本页全部角色" Value="@(rows.Length>0&&rows.All(r=>selected.ContainsKey(r.Profile.Id)))" ValueChanged="SelectPage" Disabled="@(busy||loading)" /></MudTh><MudTh>昵称 / 人格</MudTh><MudTh>职业 / 等级 / 地图</MudTh><MudTh>状态与原因</MudTh><MudTh>今日在线 / 调度</MudTh><MudTh>操作</MudTh></HeaderContent>
    <RowTemplate>
        <MudTd><MudCheckBox T="bool" Dense="true" aria-label="@($"选择{context.Profile.Name}")" Value="selected.ContainsKey(context.Profile.Id)" ValueChanged="@(v=>Select(context,v))" Disabled="@(busy||loading)" /></MudTd>
        <MudTd>@context.Profile.Name<br /><MudText Typo="Typo.caption">@PresetName(context.Profile) · @context.Profile.Alias</MudText></MudTd>
        <MudTd>@ChineseText.Name(((MirClass)context.Profile.Class).ToString()) / @context.Level<br />@context.Map @if(context.X.HasValue){<span class="coordinate">(@context.X, @context.Y)</span>}</MudTd>
        <MudTd>@context.State<br /><MudText Typo="Typo.caption">@context.Reason</MudText>@if(context.LastError.Length>0){<MudText Color="Color.Error" Typo="Typo.caption">@context.LastError</MudText>}</MudTd>
        <MudTd>@(context.TodaySeconds/60) / @context.Profile.Schedule.DailyMinutes 分钟<br /><MudText Typo="Typo.caption">@(context.Profile.Scheduled?"按日程":"仅手动") · @context.Profile.Schedule.TimeZone<br />@DispatchText(context)</MudText></MudTd>
        <MudTd Class="admin-row-actions"><MudStack Row="true" Wrap="Wrap.Wrap" Spacing="0"><MudButton Size="Size.Small" OnClick="@(()=>Edit(context))" Variant="Variant.Text" Color="Color.Primary">管理</MudButton><MudButton Size="Size.Small" Color="Color.Success" OnClick="@(()=>Command(context,"start"))" Variant="Variant.Text">启动</MudButton><MudButton Size="Size.Small" OnClick="@(()=>Command(context,context.State=="已暂停"?"resume":"pause"))" Variant="Variant.Text" Color="Color.Primary">@(context.State=="已暂停"?"继续":"暂停")</MudButton><MudButton Size="Size.Small" Color="Color.Warning" OnClick="@(()=>Command(context,"stop"))" Variant="Variant.Text">下线</MudButton><MudButton Size="Size.Small" OnClick="@(()=>Inspect(context.Profile.Id))" Variant="Variant.Text" Color="Color.Primary">详情</MudButton><MudButton Size="Size.Small" Color="Color.Error" OnClick="@(()=>Release(context))" Variant="Variant.Text">解除托管</MudButton></MudStack></MudTd>
    </RowTemplate>
    <NoRecordsContent><MudText>当前版本没有匹配的陪玩档案。</MudText></NoRecordsContent>
    </MudTable>
    <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Class="my-3">
        <MudSelect T="int" Label="每页条数" Value="pageSize" ValueChanged="ChangePageSize" Disabled="@(busy||loading)" Margin="Margin.Dense" Variant="Variant.Outlined" Dense="true" Class="companion-page-size">
            @foreach(var size in PageSizes){<MudSelectItem Value="size">@size</MudSelectItem>}
        </MudSelect>
        <MudButton Disabled="@(busy||loading||page==0)" OnClick="Previous" Size="Size.Small" Variant="Variant.Text" Color="Color.Default">上一页</MudButton><MudText>第 @(page+1) 页，共 @total 条，每页 @pageSize 条</MudText><MudButton Disabled="@(busy||loading||(page+1)*pageSize>=total)" OnClick="Next" Size="Size.Small" Variant="Variant.Text" Color="Color.Default">下一页</MudButton></MudStack>
</MudTabPanel>
<MudTabPanel Text="人格管理">
    <MudTable T="PersonalityPreset" Items="overview.Presets" Dense="true" RowsPerPage="12">
        <HeaderContent><MudTh>名称 / 修订</MudTh><MudTh>描述</MudTh><MudTh>勤奋 / 对抗 / 风险 / 社交 / 助人 / 探索</MudTh><MudTh>操作</MudTh></HeaderContent>
        <RowTemplate><MudTd>@context.Name · v@context.Revision<br />@(context.BuiltIn?"内置":"自定义") · @context.Key @(context.Archived?"（已归档）":"")</MudTd><MudTd>@context.Description</MudTd><MudTd>@string.Join(" / ",PersonalityPresets.Values(context.Traits).Take(6))</MudTd><MudTd Class="admin-row-actions"><MudButton Size="Size.Small" OnClick="@(()=>preset=context)" Variant="Variant.Text" Color="Color.Primary">@(context.BuiltIn?"复制为自定义":"新建修订")</MudButton>@if(!context.BuiltIn){<MudButton Size="Size.Small" OnClick="@(()=>Archive(context))" Variant="Variant.Text" Color="Color.Primary">@(context.Archived?"恢复":"归档")</MudButton>}</MudTd></RowTemplate>
        <PagerContent><MudTablePager RowsPerPageString="每页条数" /></PagerContent>
    </MudTable>
</MudTabPanel>
<MudTabPanel Text="日程管理">
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="my-3">
        <MudText>预设只用于填入参数；修改或删除预设不改变角色已保存的日程。时间按各预设时区解释。</MudText>
        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="@(()=>schedulePreset=new(Guid.NewGuid(),"",new()))">新增日程</MudButton>
    </MudStack>
    <MudTable T="CompanionSchedulePreset" Items="overview.SchedulePresets" Dense="true" Hover="true">
        <HeaderContent><MudTh>名称 / 时区</MudTh><MudTh>在线时段</MudTh><MudTh>出勤 / 单次 / 休息 / 每日上限</MudTh><MudTh>操作</MudTh></HeaderContent>
        <RowTemplate>
            <MudTd>@context.Name<br /><MudText Typo="Typo.caption">@context.Schedule.TimeZone</MudText></MudTd>
            <MudTd>@foreach(var window in context.Schedule.Windows){<MudText Typo="Typo.body2">@WindowText(window)</MudText>}</MudTd>
            <MudTd>@context.Schedule.Attendance% / @context.Schedule.SessionMinutes / @context.Schedule.RestMinutes / @context.Schedule.DailyMinutes 分钟</MudTd>
            <MudTd Class="admin-row-actions"><MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" OnClick="@(()=>schedulePreset=context)">编辑</MudButton><MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="@(()=>DeleteSchedule(context))">删除</MudButton></MudTd>
        </RowTemplate>
        <NoRecordsContent><MudText>尚无日程预设，角色仍可手动设置日程。</MudText></NoRecordsContent>
    </MudTable>
</MudTabPanel>
<MudTabPanel Text="兼容与能力">
    <MudTable T="CompanionCapability" Items="overview.Capabilities" Dense="true"><HeaderContent><MudTh>能力</MudTh><MudTh>状态</MudTh><MudTh>说明</MudTh></HeaderContent><RowTemplate><MudTd>@context.Name</MudTd><MudTd>@context.State</MudTd><MudTd>@context.Detail</MudTd></RowTemplate></MudTable>
</MudTabPanel>
</MudTabs>
}
@if(draft!=null&&overview!=null){<CompanionEditor @key="draft.Id" Profile="draft" Presets="overview.Presets" Models="overview.Settings.Models" SchedulePresets="@(overview.SchedulePresets??[])" DefaultModelId="overview.Settings.DefaultModelId" AvailableClasses="@(overview.AvailableClasses??[0,1,2])" Bound="bound" OnClose="@(()=>draft=null)" OnSaved="Saved" />}
@if(settingsDraft!=null){<CompanionSettingsDialog Settings="settingsDraft" ArrivalStatus="overview?.Arrivals" SchedulePresets="@(overview?.SchedulePresets??[])" UsedNicknames="@(overview?.UsedNicknames??[])" OnClose="@(()=>settingsDraft=null)" OnSaved="Saved" />}
@if(batch&&overview!=null){<CompanionBatchDialog Overview="overview" OnClose="@(()=>batch=false)" OnSaved="Saved" />}
@if(preset!=null&&overview!=null){<PresetDialog Source="preset" Presets="overview.Presets" OnClose="@(()=>preset=null)" OnSaved="Saved" />}
@if(schedulePreset!=null){<CompanionScheduleDialog @key="schedulePreset.Id" Preset="schedulePreset" OnClose="@(()=>schedulePreset=null)" OnSaved="Saved" />}
@if(selectedLlm!=null&&overview!=null){<CompanionSelectedLlmDialog Profiles="selectedLlm" Models="overview.Settings.Models" DefaultModelId="overview.Settings.DefaultModelId" OnClose="@(()=>selectedLlm=null)" OnSaved="SelectedSaved" />}
@if(selectedSchedules!=null){<CompanionSelectedScheduleDialog Profiles="selectedSchedules" Presets="@(overview?.SchedulePresets??[])" OnClose="@(()=>selectedSchedules=null)" OnSaved="SelectedSaved" />}
@if(detail!=null)
{
    <AdminDialog Visible="true" Title="陪玩运行与日程详情" OnClose="@(()=>detail=null)"><DialogContent>
        <MudText Typo="Typo.h6">@detail.Row.Profile.Name · @detail.Row.State</MudText><MudText>@detail.Row.Reason</MudText>
        <MudText Class="my-2">地图：@(string.IsNullOrEmpty(detail.Row.Map)?"—":detail.Row.Map) @if(detail.Row.X.HasValue){<span class="coordinate">(@detail.Row.X, @detail.Row.Y)</span>}</MudText>
        <MudText Class="my-2">原账户 #@detail.Row.AccountId · 角色 #@detail.Row.CharacterId · 今天已预留/使用 @(detail.Row.TodaySeconds/60) 分钟</MudText>
        <MudText>@DispatchText(detail.Row)</MudText>
        @if(detail.Row.LastSessionReason.Length>0){<MudText Typo="Typo.caption">上次下线：@detail.Row.LastSessionReason</MudText>}
        @if(detail.Row.LastError.Length>0){<MudAlert Severity="Severity.Error">@detail.Row.LastError</MudAlert>}
        @if(detail.Runtime is { } runtime)
        {
            <MudDivider Class="my-3" /><MudText Typo="Typo.subtitle1">当前发育进度</MudText>
            <MudText>生命 @runtime.Hp / @runtime.MaxHp · 魔力 @runtime.Mp / @runtime.MaxMp · 金币 @runtime.Gold · 经验 @runtime.Experience / @runtime.MaxExperience</MudText>
            <MudText>背包负重 @runtime.BagWeight / @runtime.MaxBagWeight · 空格 @runtime.EmptySlots</MudText>
            <MudText>行会：@(runtime.GuildName.Length>0?runtime.GuildName:"未加入") @if(runtime.GuildGoal.Length>0){<span> · @runtime.GuildGoal</span>}</MudText>
            @if(runtime.Goal is { } goal){<MudText Class="my-2">目标：@goal.Reason · 目标坐标 (@goal.X, @goal.Y)</MudText>}
            @foreach(var task in runtime.Tasks){<MudText Typo="Typo.body2">@task</MudText>}
            <CompanionCombat Value="runtime.Combat" />
        }
        <MudDivider Class="my-3" /><MudText Typo="Typo.subtitle1">未来在线窗口</MudText>
        @foreach(var p in detail.Schedule){<MudText>@Local(p.Start,detail.Row.Profile.Schedule.TimeZone) — @Local(p.End,detail.Row.Profile.Schedule.TimeZone) · @(p.Attending?"预计出勤":"休息")</MudText>}
        <MudDivider Class="my-3" /><MudText Typo="Typo.subtitle1">最近运行事件</MudText><CompanionEvents Events="detail.Events" Zone="@detail.Row.Profile.Schedule.TimeZone" />
    </DialogContent></AdminDialog>
}
@code{
    private CompanionOverview? overview;private CompanionRow[] rows=[];private CompanionProfile? draft;private CompanionSettings? settingsDraft;private PersonalityPreset? preset;private CompanionDetail? detail;
    private readonly Dictionary<Guid,CompanionRow> selected=[];
    private CompanionSchedulePreset? schedulePreset;private CompanionRow[]? selectedSchedules,selectedLlm;
    private static readonly int[] PageSizes=[10,20,30,50,100];
    private int pageSize=10;
    private string search="",status="";private string? error,notice;private int page,total,loadVersion;private bool busy,loading,bound,batch;
    private readonly CancellationTokenSource cancellation=new();private Task? polling;
    protected override async Task OnInitializedAsync(){await Load();polling=Poll();}
    private async Task Poll(){try{using var timer=new PeriodicTimer(TimeSpan.FromSeconds(5));while(await timer.WaitForNextTickAsync(cancellation.Token))if(draft==null&&settingsDraft==null&&preset==null&&schedulePreset==null&&selectedSchedules==null&&selectedLlm==null&&!busy&&!loading&&!batch)await InvokeAsync(async()=>{await Load();if(detail!=null)await RefreshDetail();StateHasChanged();});}catch(OperationCanceledException)when(cancellation.IsCancellationRequested){}}
    private async Task Load()
    {
        var request=++loadVersion;loading=true;
        try
        {
            var summary=await Api.Get<CompanionOverview>("management/companions/overview",cancellation.Token);
            var result=await Api.Get<CompanionPage>($"management/companions?page={page}&pageSize={pageSize}&status={status}&search={Uri.EscapeDataString(search)}",cancellation.Token);
            if(request!=loadVersion)return;
            overview=summary;rows=result.Items;total=result.Total;error=null;
            foreach(var row in rows)if(selected.ContainsKey(row.Profile.Id))selected[row.Profile.Id]=row;
            if(page>0&&page*pageSize>=total){page=Math.Max(0,(total-1)/pageSize);await Load();}
        }
        catch(Exception e)when(!cancellation.IsCancellationRequested){if(request==loadVersion)error=e.Message;}
        finally{if(request==loadVersion)loading=false;}
    }
    private Task ChangePageSize(int value){if(!PageSizes.Contains(value))return Task.CompletedTask;pageSize=value;return Search();}
    private Task FilterStatus(string value){status=value;return Search();}
    private Task Search(){page=0;return Load();}private Task Previous(){page--;return Load();}private Task Next(){page++;return Load();}
    private string PresetName(CompanionProfile p)=>overview?.Presets.FirstOrDefault(x=>x.Key==p.PresetKey&&x.Revision==p.PresetRevision)?.Name??p.PresetKey;
    private static string Local(DateTimeOffset? value,string zone)=>value==null?"—":TimeZoneInfo.ConvertTime(value.Value,CompanionScheduling.Zone(zone)).ToString("MM-dd HH:mm");
    private static string DispatchText(CompanionRow row)=>row.QueuePosition is { } position?$"候位第 {position} 位":
        row.SessionUntil!=null?$"本次预计至 {Local(row.SessionUntil,row.Profile.Schedule.TimeZone)}":
        row.RestUntil>DateTimeOffset.UtcNow?$"休息至 {Local(row.RestUntil,row.Profile.Schedule.TimeZone)}":"";
    private void New(){draft=new(){Id=Guid.NewGuid()};bound=false;}
    private void Edit(CompanionRow row){draft=JsonSerializer.Deserialize<CompanionProfile>(JsonSerializer.Serialize(row.Profile));bound=row.CharacterId>0;}
    private void Settings()=>settingsDraft=JsonSerializer.Deserialize<CompanionSettings>(JsonSerializer.Serialize(overview!.Settings));
    private async Task Saved(){draft=null;settingsDraft=null;preset=null;schedulePreset=null;batch=false;notice="已保存。";await Load();}
    private async Task Inspect(Guid id){try{detail=await Api.Get<CompanionDetail>($"management/companions/{id}");}catch(Exception e){error=e.Message;}}
    private async Task RefreshDetail()
    {
        var current=detail;if(current==null)return;
        try{var latest=await Api.Get<CompanionDetail>($"management/companions/{current.Row.Profile.Id}",cancellation.Token);if(ReferenceEquals(detail,current))detail=latest;}
        catch(Exception e)when(!cancellation.IsCancellationRequested){error=e.Message;}
    }
    private async Task Command(CompanionRow row,string action){busy=true;try{await Api.Post<ActionResult>($"management/companions/{row.Profile.Id}/command",new CompanionCommand(action,row.Profile.Version));notice="操作已提交，状态将自动刷新。";await Load();}catch(Exception e){error=e.Message;}finally{busy=false;}}
    private async Task Release(CompanionRow row){if(await AdminDialog.Confirm(Dialogs,"解除陪玩托管",$"移除「{row.Profile.Name}」的托管档案？原账户、角色和物品全部保留；需先下线。","确认解除"))await Command(row,"release");}
    private async Task Archive(PersonalityPreset p){if(!await AdminDialog.Confirm(Dialogs,p.Archived?"恢复人格修订":"归档人格修订","已引用的角色参数保留，此操作只改变新建时是否可选。","确认操作"))return;try{await Api.Post<ActionResult>($"management/companions/presets/{p.Key}/{p.Revision}/archive?archived={!p.Archived}");await Load();}catch(Exception e){error=e.Message;}}
    private void Select(CompanionRow row,bool value){if(value)selected[row.Profile.Id]=row;else selected.Remove(row.Profile.Id);}
    private void SelectPage(bool value){foreach(var row in rows)Select(row,value);}
    private async Task SelectedSaved(){selected.Clear();selectedSchedules=null;selectedLlm=null;await Saved();}
    private async Task SelectedCommand(string action)
    {
        if(busy||loading||selected.Count==0)return;var targets=selected.Values.ToArray();busy=true;
        try
        {
            var verb=action=="start"?"上线":"下线";
            var explanation=action=="start"?"保留总开关、日程、休息与用量限制；有错误保护时本批次不执行。":"本次窗口内抑制自动重连，并等待原连接正常退出。";
            if(!await AdminDialog.Confirm(Dialogs,$"批量{verb}",$"仅为选中的 {targets.Length} 个角色提交{verb}？{string.Join("、",targets.Take(12).Select(r=>r.Profile.Name))}{(targets.Length>12?"……":"")}。{explanation}",verb))return;
            notice=(await Api.Post<ActionResult>("management/companions/selected-command",new CompanionSelectedCommand(action,targets.Select(r=>new CompanionSelection(r.Profile.Id,r.Profile.Version)).ToArray()))).Message;
            selected.Clear();error=null;await Load();
        }
        catch(Exception e){error=e.Message;}finally{busy=false;}
    }
    private async Task DeleteSchedule(CompanionSchedulePreset value)
    {
        if(!await AdminDialog.Confirm(Dialogs,"删除日程预设",$"删除「{value.Name}」？已有角色的日程参数保持不变。","删除"))return;
        try{await Api.Post<ActionResult>($"management/companions/schedules/{value.Id}/delete",new CompanionCommand("delete",value.Version));await Load();}catch(Exception e){error=e.Message;}
    }
    private static string WindowText(OnlineWindow value)
    {
        string[] days=["日","一","二","三","四","五","六"];
        var selectedDays=value.Days==127?"每天":"周"+string.Join("、",days.Where((_,i)=>(value.Days&(1<<i))!=0));
        return $"{selectedDays} · {(value.AllDay?"全天":$"{value.StartMinute/60:00}:{value.StartMinute%60:00}–{value.EndMinute/60:00}:{value.EndMinute%60:00}{(value.EndMinute<value.StartMinute?"（次日）":"")}")}";
    }
    public async ValueTask DisposeAsync(){cancellation.Cancel();if(polling!=null)await polling;cancellation.Dispose();}
}
