<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefineConstants>$(DefineConstants);PORTABLE_CLIENT</DefineConstants>
    <NoWarn>$(NoWarn);CS8600;CS8602;CS8604;CS8625</NoWarn>
    <StartupAssetArchive>$(MSBuildProjectDirectory)/.godot/mono/temp/startup/$(Configuration)/startup.zip</StartupAssetArchive>
    <StartupAssetMode Condition="'$(RequireClientStartupAssets)' == 'true'">required</StartupAssetMode>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Shared/Mir2.Shared.csproj" />
    <ProjectReference Include="../Client.Core/Mir2.Client.Core.csproj" />
    <ProjectReference Include="../Resources/Mir2.Resources.csproj" />
    <ProjectReference Include="../../scripts/ClientStartupAssets/ClientStartupAssets.csproj"
                      ReferenceOutputAssembly="false" OutputItemType="StartupAssetTool" Private="false" />
    <EmbeddedResource Include="$(StartupAssetArchive)" LogicalName="ClientStartupAssets.zip" />
  </ItemGroup>
  <Target Name="BuildClientStartupAssets" BeforeTargets="CoreCompile" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="dotnet &quot;@(StartupAssetTool)&quot; &quot;$(StartupAssetArchive)&quot; &quot;$(StartupAssetMode)&quot;" />
  </Target>
</Project>
